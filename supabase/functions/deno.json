{
  "lock": false,
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "zod": "npm:zod@4",
    "date-fns": "npm:date-fns@4",
    "date-fns-tz": "npm:date-fns-tz@3",
    "decimal.js": "npm:decimal.js@10",
    "pdf-lib": "npm:pdf-lib@1.17",
    "@std/assert": "jsr:@std/assert@1"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
