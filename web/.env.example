# Supabase
# Obtén estos valores desde el dashboard de Supabase (Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# La service_role key NUNCA se expone al cliente. Solo se usa en
# Edge Functions o en código del servidor que lo requiera explícitamente.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pruebas E2E (Playwright) — solo para entorno de test.
# URL donde corre la app durante los tests (por defecto http://localhost:3000).
E2E_BASE_URL=http://localhost:3000
# Credenciales de un usuario de prueba con membresía activa.
# NUNCA uses credenciales reales de producción aquí.
E2E_USER_EMAIL=tester@example.com
E2E_USER_PASSWORD=cambia-esta-clave
# Pon "false" para que Playwright levante su propio servidor dev en vez de
# reutilizar uno ya en marcha.
# E2E_REUSE_SERVER=true
