# Plantilla de local.properties.
# Copia este archivo a `local.properties` (gitignored) y rellénalo con tus valores.
# Android Studio añadirá automáticamente `sdk.dir`.

# Supabase: URL y anon key del proyecto contra el que desarrollar.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Ruta al SDK de Android (la rellena Android Studio).
# sdk.dir=/Users/<user>/Library/Android/sdk
