<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base usado por el splash y por compatibilidad. El tema real
         (Material 3) se aplica desde Compose en `RecreTheme`. -->
    <style name="Theme.Recre" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Splash del sistema (core-splashscreen): icono de la app en vez del
         spinner genérico. MainActivity lo retiene mientras la sesión se
         resuelve y postSplashScreenTheme devuelve el tema real. -->
    <style name="Theme.Recre.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Recre</item>
    </style>
</resources>
